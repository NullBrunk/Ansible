#!/bin/bash
HOSTNAME="{{ inventory_hostname }}"
DNS_SERVER="IP_SERVER"

TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
NEW_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/public-ipv4)

nsupdate -k /opt/tsig.key << NSUPDATE
server $DNS_SERVER
zone dev
update delete ${HOSTNAME}.dev A
update add ${HOSTNAME}.dev 300 A $NEW_IP
send
NSUPDATE
